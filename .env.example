# Copie para .env (que o git ignora) e preencha só o que for usar.
# Sem nenhuma chave, a geração de imagem usa Pollinations (grátis, sem cadastro, pode vir com marca d'água).

# Hugging Face (grátis, melhor qualidade): https://huggingface.co/settings/tokens  (token do tipo "Read")
HF_TOKEN=

# Cloudflare Workers AI (grátis até a cota diária): Account ID no painel + token com permissão "Workers AI"
CF_ACCOUNT_ID=
CF_API_TOKEN=
